# Copy to .env and fill in. Only the Qwen key is needed for the AI; without it
# every AI feature uses its built-in fallback (standard questions, scripted answers).

# Qwen on Alibaba Cloud DashScope (Model Studio). QWEN_API_KEY also works.
DASHSCOPE_API_KEY=

# Optional: first model to try (falls back to qwen-max, qwen3.5-plus, qwen-flash).
AI_MODEL=qwen3.7-plus

# Optional: only for mainland-China keys use https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: MongoDB (e.g. Atlas). Empty = data saved to server/data/*.json on this machine.
MONGO_URI=

# Optional: API port (hosting platforms usually set this).
PORT=3001

# Optional: set to 1 to switch the AI off and use the fallbacks.
AI_DISABLED=
